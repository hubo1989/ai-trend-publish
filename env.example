# AI趋势发布系统环境变量配置

# API认证
SERVER_API_KEY=your-secret-api-key-here

# 数据库配置
ENABLE_DB=true
DB_HOST=db
DB_PORT=3306
DB_USER=trendfinder
DB_PASSWORD=trendfinder123
