# AI趋势发布系统 - 生产环境配置
# 复制此文件到docker目录并重命名为 .env

# ===========================================
# 应用基础配置
# ===========================================
NODE_ENV=production
LOG_LEVEL=INFO

# API认证密钥（必须修改）
SERVER_API_KEY=your-super-secret-api-key-change-me

# 应用端口配置
APP_PORT=8000

# ===========================================
# 服务端口配置
# ===========================================
# 后端API端口
BACKEND_PORT=8000

# 前端Web端口
FRONTEND_PORT=8080

# HTTP/HTTPS端口（使用nginx时）
HTTP_PORT=80
HTTPS_PORT=443

# ===========================================
# Docker镜像配置
# ===========================================
# 后端镜像（替换为您的镜像仓库地址）
BACKEND_IMAGE=ai-trend-backend:latest

# 前端镜像（替换为您的镜像仓库地址）
FRONTEND_IMAGE=ai-trend-frontend:latest

# ===========================================
# 数据库配置
# ===========================================
ENABLE_DB=true

# MySQL版本
MYSQL_VERSION=8.0

# 数据库连接配置
DB_HOST=db
DB_PORT=3306
DB_EXTERNAL_PORT=3306
DB_DATABASE=trendfinder
DB_USER=trendfinder

# 数据库密码（必须修改）
DB_PASSWORD=your-strong-db-password-change-me
DB_ROOT_PASSWORD=your-strong-root-password-change-me

# ===========================================
# Redis配置
# ===========================================
REDIS_VERSION=7-alpine
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_EXTERNAL_PORT=6379

# Redis密码（可选，建议设置）
REDIS_PASSWORD=your-redis-password-change-me

# ===========================================
# Nginx配置
# ===========================================
NGINX_VERSION=alpine

# ===========================================
# 网络配置
# ===========================================
NETWORK_SUBNET=172.20.0.0/16
NETWORK_GATEWAY=172.20.0.1

# ===========================================
# 数据存储配置
# ===========================================
# 数据目录（相对于docker-compose.yml文件的路径）
DATA_DIR=./data

# 项目名称（用于数据卷命名）
PROJECT_NAME=ai-trend-publish

# 网络配置
NETWORK_NAME=docker-network

# ===========================================
# 外部服务API配置（可选）
# ===========================================
# OpenAI兼容服务配置
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

# 默认LLM提供商
DEFAULT_LLM_PROVIDER=OPENAI

# FireCrawl API密钥
FIRECRAWL_API_KEY=

# Jina AI API密钥
JINA_API_KEY=

# 阿里云DashScope API密钥
DASHSCOPE_API_KEY=

# 讯飞API密钥
XUNFEI_API_KEY=

# 通知服务配置
ENABLE_FEISHU=false
FEISHU_WEBHOOK_URL=

ENABLE_DINGDING=false
DINGDING_WEBHOOK=

ENABLE_BARK=false
BARK_URL=

# 其他AI服务配置
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# AZURE_OPENAI_API_KEY=

# ===========================================
# 高级配置（通常不需要修改）
# ===========================================
# 数据库连接池配置
DB_MAX_CONNECTIONS=20
DB_CONNECTION_TIMEOUT=60000

# Redis连接配置
REDIS_CONNECTION_TIMEOUT=5000
REDIS_RETRY_ATTEMPTS=3

# 应用性能配置
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT=30000

# 文件上传配置
MAX_FILE_SIZE=10MB
UPLOAD_DIR=/app/uploads

# 日志配置
LOG_MAX_FILES=10
LOG_MAX_SIZE=10MB
